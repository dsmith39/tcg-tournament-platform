# Copy this file to .env and fill in real values before running the server.
PORT=3001
HOST=127.0.0.1
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# No database URL needed for local dev -- the card catalog is a SQLite file
# (card-database/data/cards.db), created automatically on first run. App data
# (users/decklists/tournaments) talks to real AWS DynamoDB under your own
# credentials; set DYNAMODB_ENDPOINT only to point at a local dynalite instance.
